<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LDPickupDoctor - The Long Dark, MelonLoader 0.7.3, Unity 6000.0.60f1, IL2CPP.

    References are taken straight from the game install, so the build always matches the
    installed game version. Nothing is restored from NuGet except the net6 targeting pack.

    Il2CppAssemblies is generated by MelonLoader on the game's FIRST modded launch. If the
    folder below does not exist, the game has never run with MelonLoader actually loaded -
    run tools\loader-doctor.ps1, which knows why that happens on this machine.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LDPickupDoctor</AssemblyName>
    <RootNamespace>LDPickupDoctor</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <!-- IL2CPP interop assemblies are unsigned and reference-only; these warnings are noise. -->
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8632;MSB3277</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\TheLongDark</GameDir>
    <MlDir>$(GameDir)\MelonLoader</MlDir>
    <InteropDir>$(MlDir)\Il2CppAssemblies</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MlDir)\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MlDir)\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MlDir)\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(MlDir)\net6\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Every generated interop assembly, referenced wholesale. Picking a minimal set by hand was
    tried in the Green Hell build and is right there, where the reference set is a dozen stable
    Unity modules. Here it is 161 assemblies whose names are decided by whatever middleware
    Hinterland shipped that patch, and a missing one shows up as a type-resolution error a long
    way from its cause. Reference-only, so none of it is copied into the output.
  -->
  <Target Name="ReferenceInterop" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <InteropAssembly Include="$(InteropDir)\*.dll" />
      <ReferencePath Include="@(InteropAssembly)">
        <Private>false</Private>
      </ReferencePath>
    </ItemGroup>
    <Error Condition="'@(InteropAssembly)' == ''"
           Text="No interop assemblies in $(InteropDir). The game has not yet run with MelonLoader loaded - see tools\loader-doctor.ps1." />
  </Target>

</Project>
